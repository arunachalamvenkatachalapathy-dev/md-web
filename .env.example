# Google Cloud Drive API v3 Configuration
# 1. Obtain an API key from Google Cloud Console with Google Drive API enabled.
# 2. Restrict the API key to HTTP Referrers (e.g. http://localhost:5173/*, https://yourdomain.com/*)
# 3. Share your target Google Drive folder with "Anyone with the link can view".

VITE_DRIVE_API_KEY=your_google_cloud_drive_api_key_here
VITE_DRIVE_FOLDER_ID=your_public_drive_folder_id_here

# Social Channel URL overrides (optional, defaults to siteConfig.js)
VITE_YOUTUBE_URL=https://www.youtube.com/@MarketDebunk
VITE_INSTAGRAM_URL=https://www.instagram.com/marketdebunk
VITE_TELEGRAM_URL=https://t.me/marketdebunk
VITE_LINKEDIN_URL=https://www.linkedin.com/in/arunachalamvenv/
VITE_PROFILE_URL=https://arunachalamvenkatachalapathy-dev.github.io/arunachalam-portfolio/
